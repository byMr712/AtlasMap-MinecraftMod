{
  "schemaVersion": 1,
  "id": "atlasmap",
  "version": "1.0",
  "name": "AtlasMap",
  "description": "A world map and minimap with 8 UI designs, colourable markers, screenshots, ruler, drawing tools and teleport. Maps are stored per server and per world.",
  "authors": ["erkinpaw", "Mr712"],
  "contact": {
    "homepage": "https://github.com/byMr712/AtlasMap-MinecraftMod",
    "sources": "https://github.com/byMr712/AtlasMap-MinecraftMod",
    "issues": "https://github.com/byMr712/AtlasMap-MinecraftMod/issues"
  },
  "license": "MIT",
  "icon": "assets/atlasmap/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.webtrade.atlasmap.client.AtlasMapClient"
    ]
  },
  "mixins": [
    "atlasmap.mixins.json",
    {
      "config": "atlasmap.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}

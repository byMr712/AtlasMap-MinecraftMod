{
  "schemaVersion": 1,
  "id": "mapminecraft",
  "version": "${version}",
  "name": "MapMinecraft",
  "description": "A world map and minimap with 8 UI designs, colourable markers, screenshots, ruler, drawing tools and teleport. Maps are stored per server and per world.",
  "authors": ["erkinpaw"],
  "contact": {
    "homepage": "https://github.com/erkinpaw/atlasmap",
    "sources": "https://github.com/erkinpaw/atlasmap",
    "issues": "https://github.com/erkinpaw/atlasmap/issues"
  },
  "license": "MIT",
  "icon": "assets/mapminecraft/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.webtrade.mapminecraft.client.MapminecraftClient"
    ]
  },
  "mixins": [
    "mapminecraft.mixins.json",
    {
      "config": "mapminecraft.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
